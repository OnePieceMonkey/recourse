{
  "name": "recourse",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "pnpm typecheck",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "setup": "pnpm --filter @recourse/agent start setup",
    "ask": "pnpm --filter @recourse/agent start ask"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "protobufjs",
      "@google/genai"
    ]
  }
}
