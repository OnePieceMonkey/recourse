# Copy to .env and fill in. Everything is optional: without keys Recourse runs
# with a fake PayPal and an offline heuristic judge, so the whole flow works keyless.

# PayPal sandbox app (developer.paypal.com -> Apps & Credentials -> Sandbox).
# Enable "Vault" under Accept payments -> Advanced options. See docs/research/paypal.md.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Jev decision model (TypeSafe) via OpenRouter, or TypeSafe directly.
OPENROUTER_API_KEY=
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-1.13

# Gemini for planning and writing the answer.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Recourse
RECOURSE_ADMIN_TOKEN=dev-admin-token
RECOURSE_PUBLIC_URL=http://localhost:4020
RECOURSE_APP_URL=http://localhost:3000
# RECOURSE_SIGNING_KEY=        # base64url JWK; created in .data/ when empty
# DATABASE_URL=                # Postgres; PGlite in .data/ when empty
# RECOURSE_ANCHOR=off          # disable OpenTimestamps anchoring

# Sandbox business accounts of the demo publishers (payout receivers)
# PAYOUT_EMAIL_NORTHWIND=
# PAYOUT_EMAIL_QUICKCHECK=
# PAYOUT_EMAIL_TIPJAR=
